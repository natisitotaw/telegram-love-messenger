# --- Telegram API credentials ---
# Get these from https://my.telegram.org -> API Development Tools
API_ID=123456
API_HASH=abcdef1234567890abcdef1234567890

# --- Generated once via auth.py, then stored as a GitHub Secret ---
STRING_SESSION=

# --- Recipient ---
# Your sister's Telegram @username (without the @) or her numeric user ID.
SISTER_USERNAME=her_telegram_username

# --- Behavior / scheduling ---
# Local send time, used for documentation/reference only (GitHub Actions cron
# is the actual trigger). Format: HH:MM 24h.
SEND_TIME=08:00

# IANA timezone used for "has today's message already been sent" checks.
TIMEZONE=Africa/Addis_Ababa

# Message selection order: "random" (default) or "sequential"
SELECTION_MODE=random

# Send a random cute image attachment every Sunday (true/false)
SUNDAY_IMAGE=true

# If set to "true", the app will do everything (pick a message, render it,
# log it) WITHOUT actually calling Telegram's send API. Useful for testing
# the whole pipeline safely.
DRY_RUN=false

# Path overrides (optional, defaults shown)
MESSAGES_FILE=messages.json
STATE_FILE=state.json
IMAGES_DIR=images
LOG_FILE=send_log.txt
